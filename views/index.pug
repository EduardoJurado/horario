extends layout

block content
  h1= title
  p Bienvenido, la fecha/hora actual es   
    b.txtHoraActual 00:00
  .container-flow
    .form-group
      button.btn.btn-primary.btn-block Registrar
    .form-group
      .input-group.input-group-sm
        .input-group-prepend
          .input-group-text
            i.fa.fa-calendar
        input#txtFecha.form-control(type="month", name="txtFecha")
        .input-group-append
          .input-group-text 
            b Horas: 
        .input-group-append
          .input-group-text Standar:
        .input-group-append
          .input-group-text Días:
        input.txtDias.form-control.text-right(type="number", name="txtDias" style="width: 6rem;max-width: 6rem;")
        .input-group-append
          .input-group-text Horas:
        input.txtHoras.form-control.text-right(type="number", name="txtHoras" style="width: 6rem;max-width: 6rem;")
        .input-group-append
          .input-group-text
            b Total:   
            span.TotalStandar 00:00
        .input-group-append
          button.btn.btn-info Trabajadas: 00:00
